{
  "name": "jinsei",
  "private": true,
  "version": "0.0.2",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @jinsei/contracts build && pnpm --parallel --filter @jinsei/api --filter @jinsei/web dev",
    "build": "pnpm --filter @jinsei/contracts build && pnpm --filter @jinsei/api build && pnpm --filter @jinsei/web build",
    "typecheck": "pnpm --filter @jinsei/contracts build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "release:check": "node scripts/version.mjs",
    "version:next": "node scripts/version.mjs --next",
    "db:generate": "pnpm --filter @jinsei/api db:generate",
    "db:migrate": "pnpm --filter @jinsei/api db:migrate",
    "db:seed": "pnpm --filter @jinsei/api db:seed",
    "infra:up": "docker compose up -d --wait",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.10.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
