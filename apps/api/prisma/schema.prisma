generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String            @id @default(cuid())
  email                  String            @unique
  passwordHash           String
  role                   String            @default("user")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  profile                Profile?
  preference             UserPreference?
  sessions               Session[]
  categories             UserMediaType[]
  statuses               UserStatus[]
  manualMedia            MediaItem[]
  entries                UserMediaEntry[]
  tags                   Tag[]
  activities             ActivityLog[]
  savedViews             SavedView[]
  collections            Collection[]
  goals                  Goal[]
  progressLogs           ProgressLog[]
  xpAwards               XpAward[]
  achievements           UserAchievement[]
  streakDays             StreakDay[]
  assets                 MediaAsset[]
  sentFriendRequests     Friendship[]      @relation("FriendRequester")
  receivedFriendRequests Friendship[]      @relation("FriendAddressee")
  sentMessages           DirectMessage[]   @relation("MessageSender")
  receivedMessages       DirectMessage[]   @relation("MessageRecipient")
  ownedClubs             Club[]
  clubMemberships        ClubMember[]
  clubPosts              ClubPost[]
}

model Profile {
  userId         String        @id
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String        @default("Minha jornada")
  username       String?       @unique
  bio            String        @default("")
  isPublic       Boolean       @default(false)
  activeTitle    String?
  showFavorites  Boolean       @default(true)
  showStatistics Boolean       @default(true)
  showReviews    Boolean       @default(true)
  showHistory    Boolean       @default(false)
  showGoals      Boolean       @default(false)
  links          ProfileLink[]
  avatarId       String?
  avatar         MediaAsset?   @relation("ProfileAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  bannerId       String?
  banner         MediaAsset?   @relation("ProfileBanner", fields: [bannerId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model UserPreference {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme            String    @default("system")
  accent           String    @default("black")
  visualTheme      String    @default("classic")
  density          String    @default("comfortable")
  sidebarCollapsed Boolean   @default(false)
  timezone         String    @default("America/Sao_Paulo")
  dateFormat       String    @default("dd/MM/yyyy")
  timeFormat       String    @default("24h")
  celebrations     Boolean   @default(true)
  onboardedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  /// Coarse device description (browser and system) shown in the session list.
  userAgent  String   @default("")
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MediaType {
  id        String          @id
  label     String
  sortOrder Int
  users     UserMediaType[]
  statuses  UserStatus[]
  items     MediaItem[]
}

model UserMediaType {
  userId      String
  mediaTypeId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType   MediaType @relation(fields: [mediaTypeId], references: [id])
  enabled     Boolean   @default(true)
  sortOrder   Int       @default(0)

  @@id([userId, mediaTypeId])
  @@index([userId, enabled, sortOrder])
}

model UserStatus {
  id          String           @id @default(cuid())
  userId      String
  mediaTypeId String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType   MediaType        @relation(fields: [mediaTypeId], references: [id])
  key         String
  label       String
  color       String
  sortOrder   Int
  entries     UserMediaEntry[]

  @@unique([userId, mediaTypeId, key])
  @@index([userId, mediaTypeId, sortOrder])
}

model MediaItem {
  id               String            @id @default(cuid())
  mediaTypeId      String
  mediaType        MediaType         @relation(fields: [mediaTypeId], references: [id])
  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  normalizedTitle  String
  description      String            @default("")
  releaseYear      Int?
  coverUrl         String?
  coverAttribution Json?
  genres           String[]
  attributionLabel String
  attributionUrl   String?
  dataLicense      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  game             GameMetadata?
  series           SeriesMetadata?
  reading          ReadingMetadata?
  movie            MovieMetadata?
  externalIds      MediaExternalId[]
  entries          UserMediaEntry[]
  detail           MediaDetail?

  @@unique([ownerId, mediaTypeId, normalizedTitle])
  @@index([mediaTypeId, title])
}

model GameMetadata {
  mediaId    String    @id
  media      MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  platforms  String[]
  developers String[]
  publishers String[]
}

model SeriesMetadata {
  mediaId       String         @id
  media         MediaItem      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  studios       String[]
  totalEpisodes Int?
  totalSeasons  Int?
  releaseStatus String         @default("unknown")
  seasons       SeriesSeason[]
}

model SeriesSeason {
  id       String         @id @default(cuid())
  mediaId  String
  series   SeriesMetadata @relation(fields: [mediaId], references: [mediaId], onDelete: Cascade)
  number   Int
  episodes Int?

  @@unique([mediaId, number])
}

model ReadingMetadata {
  mediaId       String    @id
  media         MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  authors       String[]
  publishers    String[]
  totalChapters Int?
  totalVolumes  Int?
  totalPages    Int?
  releaseStatus String    @default("unknown")
}

model MovieMetadata {
  mediaId        String    @id
  media          MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  directors      String[]
  runtimeMinutes Int?
}

/// Rich public information gathered from free catalogs, refreshed periodically.
model MediaDetail {
  mediaId   String    @id
  media     MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  source    String
  data      Json
  fetchedAt DateTime  @default(now())
}

model MediaExternalId {
  id              String    @id @default(cuid())
  mediaId         String
  media           MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  provider        String
  externalId      String
  synchronizedAt  DateTime  @default(now())
  retentionPolicy String

  @@unique([provider, externalId])
}

model UserMediaEntry {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId         String
  media           MediaItem        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  statusId        String
  status          UserStatus       @relation(fields: [statusId], references: [id])
  ratingSteps     Int?
  startedOn       DateTime?        @db.Date
  completedOn     DateTime?        @db.Date
  boardRank       Float            @default(0)
  favorite        Boolean          @default(false)
  notes           String           @default("")
  review          String           @default("")
  reviewPublic    Boolean          @default(false)
  recommendation  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  gameProgress    GameProgress?
  episodeProgress EpisodeProgress?
  readingProgress ReadingProgress?
  viewings        EntryViewing[]
  collectionItems CollectionItem[]
  progressLogs    ProgressLog[]
  tags            EntryTag[]
  activities      ActivityLog[]

  @@unique([userId, mediaId])
  @@index([userId, updatedAt])
  @@index([userId, statusId])
  @@index([userId, favorite])
  @@index([userId, completedOn])
  @@index([userId, startedOn])
  @@index([userId, statusId, boardRank])
  @@index([userId, reviewPublic])
  @@index([mediaId, reviewPublic])
  @@index([mediaId, ratingSteps])
}

model GameProgress {
  entryId       String         @id
  entry         UserMediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  minutesPlayed Int            @default(0)
  completion    Int            @default(0)
}

model EpisodeProgress {
  entryId         String         @id
  entry           UserMediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  episodesWatched Int            @default(0)
}

model ReadingProgress {
  entryId      String         @id
  entry        UserMediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  chaptersRead Int            @default(0)
  volumesRead  Int            @default(0)
  pagesRead    Int            @default(0)
}

model EntryViewing {
  id        String         @id @default(cuid())
  entryId   String
  entry     UserMediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  watchedOn DateTime       @db.Date
  createdAt DateTime       @default(now())

  @@index([entryId, watchedOn])
}

model Tag {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  color          String     @default("violet")
  entries        EntryTag[]

  @@unique([userId, normalizedName])
}

model EntryTag {
  entryId String
  entry   UserMediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
}

model ActivityLog {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId   String?
  entry     UserMediaEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  action    String
  changes   Json
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
}

model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  name      String
  position  Int      @default(0)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope, name])
  @@index([userId, scope, position])
}

model InstanceSettings {
  id                     String   @id @default("instance")
  name                   String   @default("Jinsei")
  description            String   @default("Sua biblioteca pessoal de entretenimento")
  contactEmail           String   @default("")
  registrationsEnabled   Boolean  @default(true)
  externalCatalogEnabled Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model Collection {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String           @default("")
  visibility  String           @default("private")
  ranked      Boolean          @default(false)
  coverUrl    String?
  coverId     String?
  cover       MediaAsset?      @relation(fields: [coverId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CollectionItem[]

  goals Goal[]

  @@unique([userId, slug])
  @@index([userId, updatedAt])
}

model CollectionItem {
  id           String         @id @default(cuid())
  collectionId String
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entryId      String
  entry        UserMediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position     Float          @default(0)
  note         String         @default("")
  createdAt    DateTime       @default(now())

  @@unique([collectionId, entryId])
  @@index([collectionId, position])
  @@index([entryId])
}

model Goal {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String      @default("")
  metric       String
  mediaTypeId  String?
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  target       Int
  startsOn     DateTime    @db.Date
  endsOn       DateTime?   @db.Date
  archived     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, archived])
}

/// Signed changes of consumption counters, dated, so goals and missions can sum activity per period.
model ProgressLog {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId     String?
  entry       UserMediaEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  mediaTypeId String
  metric      String
  delta       Int
  occurredOn  DateTime        @db.Date
  createdAt   DateTime        @default(now())

  @@index([userId, metric, occurredOn])
}

/// One-time experience rewards (missions, goals, milestones), unique per key so they never repeat.
model XpAward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  amount    Int
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

model UserAchievement {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@id([userId, key])
}

/// Days on which all daily missions were completed, in the person's time zone.
model StreakDay {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date

  @@id([userId, day])
}

/// Images uploaded by a person; binaries live in S3-compatible storage, only references here.
model MediaAsset {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String       @unique
  purpose     String
  contentType String
  size        Int
  createdAt   DateTime     @default(now())
  avatarOf    Profile[]    @relation("ProfileAvatar")
  bannerOf    Profile[]    @relation("ProfileBanner")
  coverOf     Collection[]

  @@index([userId, purpose])
}

model ProfileLink {
  id       String  @id @default(cuid())
  userId   String
  profile  Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  label    String
  url      String
  position Int     @default(0)

  @@index([userId, position])
}

/// A friend request; once accepted the pair are friends in both directions.
model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User      @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model Club {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  description    String       @default("")
  mediaTypeId    String?
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members        ClubMember[]
  posts          ClubPost[]
  createdAt      DateTime     @default(now())
  lastActivityAt DateTime     @default(now())

  @@index([lastActivityAt])
}

model ClubMember {
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@id([clubId, userId])
  @@index([userId])
}

model ClubPost {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}
