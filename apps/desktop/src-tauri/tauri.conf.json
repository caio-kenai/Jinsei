{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jinsei",
  "version": "../package.json",
  "identifier": "site.kenai.jinsei",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "category": "Entertainment",
    "publisher": "Caio Pacifico",
    "copyright": "© 2026 Caio Pacifico · GNU AGPL v3",
    "homepage": "https://github.com/caio-kenai/Jinsei",
    "shortDescription": "Organize jogos, animes, mangás, filmes, séries e livros.",
    "longDescription": "Jinsei é uma plataforma gratuita e open source para organizar e acompanhar suas experiências de cultura e entretenimento. Este aplicativo se conecta a uma instância online do Jinsei.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English", "Spanish"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "games"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
