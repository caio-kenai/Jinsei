JINSEI_VERSION=0.1.4
JINSEI_REGISTRY=ghcr.io/caio-kenai
POSTGRES_PASSWORD=substitua_por_uma_senha_aleatoria_sem_caracteres_reservados_de_URL
PUBLIC_ORIGIN=http://localhost:3000
JINSEI_BIND=127.0.0.1
JINSEI_PORT=3000
JINSEI_DOMAIN=jinsei.example.com
INSTANCE_NAME=Meu Jinsei
IGDB_ENABLED=false
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
TMDB_READ_TOKEN=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Pasta das imagens enviadas quando o S3 não está configurado (volume media). Deixe vazio para desligar.
MEDIA_DIR=/data/media
# E-mail (confirmação de conta e recuperação de senha). Exemplo com Gmail: smtp.gmail.com,
# porta 587, SMTP_SECURE=false e uma senha de app. Sem SMTP_HOST, esses recursos ficam desligados.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFICATION=required
# Chave com 32+ caracteres que criptografa os segredos da verificação em duas etapas.
# Gere uma com: openssl rand -hex 32. Guarde junto do backup: sem ela, quem usa 2FA perde o acesso.
SECRET_KEY=
